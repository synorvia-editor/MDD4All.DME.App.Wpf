<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows7.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <ApplicationIcon>Synorvia_icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="DataAccess\**" />
      <Compile Remove="Data\**" />
      <Content Remove="DataAccess\**" />
      <Content Remove="Data\**" />
      <EmbeddedResource Remove="DataAccess\**" />
      <EmbeddedResource Remove="Data\**" />
      <None Remove="DataAccess\**" />
      <None Remove="Data\**" />
      <Page Remove="DataAccess\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.120" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <!-- The application built only from what is on nuget.org; the -dev project builds it from the sibling repositories. -->
    <ItemGroup>
      <PackageReference Include="MDD4All.Configuration" Version="3.0.0.15" />
      <PackageReference Include="MDD4All.DME.AssemblyTree" Version="2.0.0.1" />
      <PackageReference Include="MDD4All.DME.AssemblyLoading" Version="2.0.0.1" />
      <PackageReference Include="MDD4All.DME.DataModels" Version="2.0.0.1" />
      <PackageReference Include="MDD4All.DME.Proxies" Version="2.0.0.2" />
      <PackageReference Include="MDD4All.DME.ViewModels" Version="2.0.0.1" />
      <PackageReference Include="MDD4All.DME.Views" Version="2.0.0.1" />
      <PackageReference Include="MDD4All.Reflection.TypeAnalyzer" Version="2.0.0.7" />
      <PackageReference Include="MDD4All.UI.Blazor" Version="2.1.0.2" />
      <PackageReference Include="Synorvia.FileAccess.WPF" Version="2.0.0.1" />
      <PackageReference Include="Synorvia.UI.BlazorComponents" Version="2.0.0.1" />
      <PackageReference Include="Synorvia.UI.DataModels" Version="2.0.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\css\bootstrap-icons\" />
    </ItemGroup>

    <ItemGroup>
      <Page Include="App.xaml" />
    </ItemGroup>

</Project>
