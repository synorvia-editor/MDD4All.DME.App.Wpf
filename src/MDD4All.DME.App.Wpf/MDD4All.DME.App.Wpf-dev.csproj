<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows7.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <ApplicationIcon>Synorvia_icon.ico</ApplicationIcon>
        <!-- Written out rather than derived from the project name: a WPF build spins up a
             temporary project of its own (..._wpftmp.csproj), and MSBuildProjectName is that
             name while the XAML is compiled. The namespace would move with it. -->
        <AssemblyName>MDD4All.DME.App.Wpf</AssemblyName>
        <RootNamespace>MDD4All.DME.App.Wpf</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="DataAccess\**" />
      <Compile Remove="Data\**" />
      <Content Remove="DataAccess\**" />
      <Content Remove="Data\**" />
      <EmbeddedResource Remove="DataAccess\**" />
      <EmbeddedResource Remove="Data\**" />
      <None Remove="DataAccess\**" />
      <None Remove="Data\**" />
      <Page Remove="DataAccess\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.120" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\MDD4All.Configuration\src\MDD4All.Configuration\MDD4All.Configuration-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.AssemblyTree\src\MDD4All.DME.AssemblyTree\MDD4All.DME.AssemblyTree-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.AssemblyLoading\src\MDD4All.DME.AssemblyLoading\MDD4All.DME.AssemblyLoading-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.DataModels\src\MDD4All.DME.DataModels\MDD4All.DME.DataModels-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.Proxies\src\MDD4All.DME.Proxies\MDD4All.DME.Proxies-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.ViewModels\src\MDD4All.DME.ViewModels\MDD4All.DME.ViewModels-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.DME.Views\src\MDD4All.DME.Views\MDD4All.DME.Views-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.Reflection.TypeAnalyzer\src\MDD4All.Reflection.TypeAnalyzer\MDD4All.Reflection.TypeAnalyzer-dev.csproj" />
      <ProjectReference Include="..\..\..\MDD4All.UI.Blazor\src\MDD4All.UI.Blazor\MDD4All.UI.Blazor-dev.csproj" />
      <ProjectReference Include="..\..\..\Synorvia.FileAccess.WPF\src\Synorvia.FileAccess.WPF\Synorvia.FileAccess.WPF-dev.csproj" />
      <ProjectReference Include="..\..\..\Synorvia.UI.BlazorComponents\src\Synorvia.UI.BlazorComponents\Synorvia.UI.BlazorComponents-dev.csproj" />
      <ProjectReference Include="..\..\..\Synorvia.UI.DataModels\src\Synorvia.UI.DataModels\Synorvia.UI.DataModels-dev.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\css\bootstrap-icons\" />
    </ItemGroup>

    <ItemGroup>
      <Page Include="App.xaml" />
    </ItemGroup>

</Project>
